# Copy this to .env and fill in values
APP_NAME=Multi-Cloud ENV Manager
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CRITICAL: Set this to a strong random key (32-byte URL-safe base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SQLite (default) or PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/envmanager
DATABASE_URL=sqlite+aiosqlite:///./envmanager.db

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
